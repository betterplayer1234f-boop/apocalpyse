{
  "schemaVersion": 1,
  "id": "zerohour",
  "version": "${version}",
  "name": "Zero Hour",
  "description": "War, an infection that turns people into the walking dead, and then the bomb. Shelter from the blast, survive the radioactive fallout and the infected, and make it to the evacuation.",
  "authors": [
    "sehrcool72"
  ],
  "license": "MIT",
  "icon": "assets/zerohour/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.zerohour.ZeroHour"
    ],
    "client": [
      "com.zerohour.client.ZeroHourClient"
    ]
  },
  "mixins": [
    {
      "config": "zerohour.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
